{
  "page": 5,
  "textScale": 1.3,
  "blocks": [
    { "type": "heading", "text": "Water Rescue Tips" },
    {
      "type": "columns",
      "columns": [
        [
          { "type": "paragraph", "lead": "REACH:", "text": "Hold on to the dock or your boat, then reach your hand, a boat oar, a fishing pole, or whatever you have nearby to the person in the water." },
          { "type": "image", "src": "assets/illustrations/rescue_reach.png" },
          { "type": "paragraph", "lead": "ROW:", "text": "If in a boat, use the oars to move the boat closer to the person in the water, or call out to a nearby boat for help. Don't use the boat's motor close to a person in the water; the propeller could injure them." },
          { "type": "image", "src": "assets/illustrations/rescue_row.png" }
        ],
        [
          { "type": "paragraph", "lead": "THROW:", "text": "If you can't reach far enough, toss things that float for the person to grab such as a life ring, life jacket, cooler, tackle box, etc." },
          { "type": "image", "src": "assets/illustrations/rescue_throw.png" },
          { "type": "paragraph", "lead": "DON'T GO:", "text": "Don't go into the water to save someone unless you are a trained lifeguard. The person that is drowning could hold you under water, and you could drown too. Yell, call 911, or go for help." },
          { "type": "image", "src": "assets/illustrations/rescue_dont_go.png" }
        ]
      ]
    },
    { "type": "paragraph", "lead": "Learn First Aid and CPR.", "text": "When giving CPR to a drowning patient, remember to give them rescue breaths and compressions. Giving them breaths provides them some oxygen, which they are lacking." },
    {
      "type": "columns",
      "columns": [
        [
          { "type": "text-input", "id": "life-jacket-why", "prompt": "Why is it important to wear a life jacket while in, on, or near the water?" },
          {
            "type": "letter-fill",
            "prompt": "If someone in the water needs help, what should you do?",
            "words": [
              { "pattern": "R__CH,", "answer": "REACH" },
              { "pattern": "_H__W,", "answer": "THROW" },
              { "pattern": "_O_,", "answer": "ROW" },
              { "pattern": "D_N'_ G_,", "answer": "DON'T GO" }
            ]
          },
          {
            "type": "paragraph",
            "text": "Scan the QR code below to watch \"Safe Passage\". The award-winning, 36-minute video for kids grades K-6 provides water safety lessons in an entertaining way.",
            "links": [{ "text": "Safe Passage", "url": "https://youtu.be/pB4IkVfM-7w" }]
          },
          {
            "type": "columns",
            "weights": [3, 1],
            "columns": [
              [ { "type": "image", "src": "assets/illustrations/safe_passage_video.png" } ],
              [ { "type": "image", "src": "assets/illustrations/safe_passage_qr.png" } ]
            ]
          }
        ],
        [
          { "type": "image", "src": "assets/illustrations/shallow_water_blackout.png" }
        ]
      ]
    }
  ]
},

